# ─────────────────────────────────────────────────────────────────────────────
# AI Deepfake & Phishing Defence System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=defence_db
POSTGRES_USER=defence_user
POSTGRES_PASSWORD=defence_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Celery broker + Django Channels layer)
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# AI Engine (FastAPI microservice)
AI_ENGINE_BASE_URL=http://localhost:8001

# ECDSA — leave blank to auto-generate on first run
ECDSA_PRIVATE_KEY_PEM=

# GGUF Model path (relative to project root)
GGUF_MODEL_PATH=models/llama-3.2-3b-instruct-q4_k_m.gguf

# LLM inference settings (memory-constrained)
LLM_N_CTX=512
LLM_N_THREADS=4
LLM_MAX_TOKENS=256

# Vision model settings
VISION_BATCH_SIZE=4
VISION_INPUT_SIZE=224

# Deepfake thresholds
LIP_SYNC_THRESHOLD_MS=80.0
MIN_BLINK_BPM=8.0
MAX_BLINK_BPM=30.0
DEEPFAKE_CONFIDENCE_THRESHOLD=0.55
